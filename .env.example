# Copy to .env. NEVER commit .env.

# Redis (queue + result store). docker-compose provides this.
REDIS_URL=redis://localhost:6379/0
# Use an in-memory fake Redis (offline / tests). 1 = fake, 0 = real.
USE_FAKE_REDIS=0

# LLM backend: echo (offline, no key) | gemini
LLM_BACKEND=echo
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Job retry policy
MAX_RETRIES=3

# OpenTelemetry: console (default) | otlp | none
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318/v1/traces
